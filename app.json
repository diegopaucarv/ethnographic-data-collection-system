{
  "expo": {
    "name": "Ethnographic Tool",
    "slug": "field-research",
    "version": "1.0.0",
    "scheme": "ethnographictool",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-location",
      "expo-image-picker",
      "expo-av"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Ayni usa tu ubicación para registrar recorridos y observaciones de campo.",
        "NSCameraUsageDescription": "Ayni usa la cámara para adjuntar evidencia a los registros.",
        "NSMicrophoneUsageDescription": "Ayni usa el micrófono para grabar entrevistas con consentimiento."
      }
    },
    "android": {
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "comchicharitomaravilloso.ethnotool"
    },
    "extra": {
      "eas": {
        "projectId": "70660d22-4798-4cda-9d69-3142b899c7d8"
      }
    }
  }
}
